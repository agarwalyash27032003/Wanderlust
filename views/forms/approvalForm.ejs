<div class="approval-options">
    <h1>Do you want to approve?</h1>
    <form action="/admin/listings/<%= listing._id%>?_method=PUT" method="post" id="listing-approval-form">
        <button class="approve-listing-btn" name = "action" type="submit" value="approve">Approve</button>
        <button class="reject-listing-btn" name = "action" type="submit" value="reject">Reject</button>
    </form>
</div>